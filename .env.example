# MC Milyoner - Ortam Değişkenleri & Servis Yapılandırması (.env)

# 1. SUNUCU & YÖNETİCİ AYARLARI
PORT=3000
SUPER_ADMIN_EMAIL=codingdevelopia@gmail.com
FRONTEND_URL=https://codingm-eng.github.io

# 2. GMAIL SMTP DOĞRUDAN İLETİM (GÜVENLİ OTP DOĞRULAMA):
# Google Hesabınızda (codingdevelopia@gmail.com) 2 Adımlı Doğrulamayı açın.
# https://myaccount.google.com/apppasswords adresinden 16 harfli Uygulama Şifresi oluşturun:
GMAIL_USER=codingdevelopia@gmail.com
# GMAIL_APP_PASSWORD=buraya_16_haneli_uygulama_sifresi_yazin

# 3. TELEGRAM BOT ENTEGRASYONU (ANKET & 24/7 DESTEK & GÜVENLİ GİRİŞ):
# @BotFather üzerinden bot oluşturun:
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_BOT_USERNAME=MCMilyonerBot
# TELEGRAM_CHAT_ID=-1001234567890
# Destek ekibi ayrı bir grupta çalışacaksa (isteğe bağlı):
# TELEGRAM_SUPPORT_BOT_TOKEN=123456789:XYZ...
# TELEGRAM_SUPPORT_GROUP_ID=-1009876543210

# 4. DISCORD OAUTH2 ENTEGRASYONU (GİRİŞ & HESAP BAĞLAMA):
# https://discord.com/developers/applications adresinden uygulama oluşturun.
# OAuth2 -> General -> Redirects kısmına: http://localhost:3000/api/auth/discord/callback ve canlı alan adınızı ekleyin.
# DISCORD_CLIENT_ID=123456789012345678
# DISCORD_CLIENT_SECRET=buraya_discord_client_secret_yazin
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# 5. STRIPE GERÇEK ÖDEME ENTEGRASYONU (RÜTBELER & ZÜMRÜT / MONETIZATION):
# https://dashboard.stripe.com/apikeys adresinden anahtarlarınızı alın:
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NOT: STRIPE_SECRET_KEY girilmediğinde sistem şeffaf biçimde yapılandırma durumunu gösterir.

# 6. GOOGLE DRIVE YEDEKLEME (İSTEĞE BAĞLI):
# GOOGLE_DRIVE_SERVICE_ACCOUNT={"type":"service_account",...}
